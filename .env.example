# Public test values only. Never use production project credentials.
EXPO_PUBLIC_APP_ENV=sandbox
EXPO_PUBLIC_APP_SCHEME=com.debtfree.native.test
EXPO_PUBLIC_SANDBOX_SUPABASE_URL=
EXPO_PUBLIC_SANDBOX_PROJECT_REF=
EXPO_PUBLIC_SANDBOX_SUPABASE_PUBLISHABLE_KEY=

# Production builds fail closed until the selected mobile endpoint/key and official app details are supplied.
# The owner chose the existing debtfree-native-auth project; sandbox and release may use that same project.
# Use synthetic accounts for app acceptance and local scratch for destructive database tests.
DFN_APP_NAME=
DFN_APP_SLUG=
# Set when preparing the later iOS release lane; the Android release candidate does not require it.
DFN_IOS_BUNDLE_ID=
DFN_ANDROID_PACKAGE=
DFN_OFFICIAL_DOMAIN=
DFN_APP_ICON_PATH=
DFN_ANDROID_ADAPTIVE_ICON_PATH=
DFN_SPLASH_IMAGE_PATH=
DFN_ANDROID_VERSION_CODE=
DFN_ANDROID_VERSION_NAME=
EXPO_PUBLIC_MOBILE_PRODUCTION_SUPABASE_URL=
EXPO_PUBLIC_MOBILE_PRODUCTION_PROJECT_REF=bitepxsdujceoszbldhd
EXPO_PUBLIC_MOBILE_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_HELP_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false

# Set these through the local environment or CI secret store. Do not commit the keystore or passwords.
DFN_RELEASE_STORE_FILE=
DFN_RELEASE_STORE_PASSWORD=
DFN_RELEASE_KEY_ALIAS=
DFN_RELEASE_KEY_PASSWORD=
